# Used by docker-compose.yml for variable substitution.
# Copy this file to .env in the repo root and fill in real values (never commit .env).
DOMAIN=pd.example.org
JWT_SECRET=please-change-me-with-a-long-random-string
NODE_ENV=production
PORT=8030
# Host bind mount: BASE_DIR/BINDS/data -> /app/data
BASE_DIR=/home/docker
BINDS=paindiary

# Optional sqlite-web admin UI (read/write DB browser, NO authentication -
# make sure this port isn't reachable from outside your LAN/VPN).
# Leave COMPOSE_PROFILES empty to skip starting it entirely.
COMPOSE_PROFILES=tools
SQLITE_WEB_PORT=8081

# Optional: use Keycloak for login instead of the built-in username/password
# auth. Leave AUTH_MODE unset (or "classic") to keep today's behavior - the
# rest of these are only read when AUTH_MODE=keycloak.
AUTH_MODE=classic
KEYCLOAK_ISSUER=https://auth.example.org/realms/horizon
KEYCLOAK_CLIENT_ID=paindiary
KEYCLOAK_BACKEND_CLIENT_ID=paindiary-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=please-change-me
